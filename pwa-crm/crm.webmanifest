{
  "name": "MOSAIC CRM",
  "short_name": "MOSAIC CRM",
  "lang": "hu",
  "description": "A MOSAIC Oxygeni belső felülete. A galériából a Megosztás gombbal képet küldhetsz a CRM-nek.",
  "id": "/crm",
  "start_url": "/crm",
  "scope": "/crm",
  "display": "standalone",
  "background_color": "#f3f4ef",
  "theme_color": "#0f3a3c",
  "icons": [
    { "src": "/assets/img/crm-ikon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/crm-ikon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/crm-ikon-maszkolhato-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/crm-megosztas",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "kep", "accept": ["image/*"] } ] }
  }
}
