   "t": "text",
   "html": "<h1 style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"font-size:40px;\"><span style=\"letter-spacing:normal;\">&Eacute;s 3 garancia, amivel nem kock&aacute;ztatsz</span></span></h1>"
