   "html": "<h1 style=\"font-size:40px; line-height:normal; text-align:center;\"><span style=\"font-size:40px;\"><span style=\"letter-spacing:normal;\">Az &ouml;r&ouml;m megdupl&aacute;z&oacute;dik, ha egy&uuml;tt &eacute;litek &aacute;t.</span></span></h1>"
