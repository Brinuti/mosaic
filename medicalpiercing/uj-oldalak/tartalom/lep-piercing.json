,"n":2,"html":"8900 Zalaegerszeg, Bíró Márton utca 8.","fs":20,"fw":400,"kozep":false,"panel":"","y":11027,"x":993,"w":217,"h":56},{"t":"p","n":0,"html":"Október 16,30<br>November 13,27<br>December 11,28","fs":16,"fw":400,"kozep":false,"kit":"zalaegerszeg","panel":"","y":11095,"x":993,"w":217,"h":77},{"t":"gomb","szoveg":"Időpontfoglalás","href":"/idopontfoglalas","kulso":false,"y":11205,"x":1026,"w":152,"h":41}]}],"kartya":true},{"t":"sor","k":[{"t":"kep","src":"/assets/img/f18724_ab288af534874091a4faa82248ce3f43.webp","alt":"","link":"","bg":false,"nw":638,"nh":368,"panel":"","y":11253,"x":212,"w":265,"h":143},{"t":"verem","k":[{"t":"h","n":2,"html":"7624 Pécs, Boszorkány út 2/1.","fs":20,"fw":400,"kozep":false,"panel":"","y":11259,"x":485,"w":217,"h":56},{"t":"p","n":0,"html":"Október 17,22,31<br>November 7,14,21,28<br>December 5,12,19,28","fs":16,"fw":400,"kozep":false,"kit":"pecs","panel":"","y":11327,"x":485,"w":217,"h":77},{"t":"gomb","szoveg":"Időpontfoglalás","href":"/idopontfoglalas","kulso":false,"y":11437,"x":518,"w":152,"h":41}]}],"kartya":true}]}]}},{"id":"comp-mdoih63o3","y":11516,"h":2472,"bgSzin":"rgb(255, 255, 255)","bgKep":"","hatterElhagyva":0,"horgonyok":[],"fa":{"t":"verem","k":[{"t":"h","n":2,"html":"Lép piercing információk","fs":40,"fw":400,"kozep":false,"panel":"","y":11563,"x":267,"w":943,"h":56},{"t":"verem","k":[{"t":"h","n":2,"html":"🧬 Mi az a lép piercing?","fs":30,"fw":400,"kozep":false,"panel":"","y":11653,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"A lép piercing egy közérzetjavító testékszer, amelyet a fül azon pontjába szúrunk, amely a hagyományos kínai orvoslás (TCM) szerint a lép energetikai zónájának felel meg. Ennek a pontnak a tartós stimulálása – az aurikuloterápia alapján – támogathatja a lép működését, különösen az emésztés, energiaszint és immunrendszer szempontjából. Vendégeink visszajelzései szerint számos panaszuk enyhült a piercing hatására.","fs":17,"fw":400,"kozep":false,"panel":"","y":11737,"x":273,"w":896,"h":95},{"t":"h","n":2,"html":"📍 Hova helyezik a fülbe?","fs":30,"fw":400,"kozep":false,"panel":"","y":11856,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"A piercinget a fülkagyló belső részén (concha területen) található lép pontra szúrjuk, amely a fülakupunktúrás térképek szerint kapcsolódik a lép szervéhez. A szúrás előtti pontos pontmeghatározás akupunktúrás pontmérő készülékkel történik.","fs":17,"fw":400,"kozep":false,"panel":"","y":11940,"x":273,"w":896,"h":71},{"t":"h","n":2,"html":"🤕 Milyen panaszok esetén lehet hatásos?","fs":30,"fw":400,"kozep":false,"panel":"","y":12273,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"Vendégeink tapasztalatai alapján a lép piercing segíthet enyhíteni az alábbi tüneteket:","fs":17,"fw":400,"kozep":false,"panel":"","y":12357,"x":273,"w":896,"h":24},{"t":"ul","rendezett":false,"elemek":["Puffadás, emésztési zavarok – a lép a tápanyagok feldolgozásáért felel, így a pont stimulálása támogathatja az emésztést.","Fáradtság, energiahiány – a TCM szerint a lép fontos szerepet játszik a Qi, azaz az életenergia szinten tartásában.","Gyenge immunrendszer – a lép az immunfunkciók egyik kulcsszereplője, így a piercing erősítheti a védekezőképességet.","Menstruációs panaszok, PMS – a lép és a női ciklus kapcsolata alapján a pont stimulálása enyhítheti a hormonális tüneteket.","Vérszegénységre való hajlam – a lép segít a vérképzésben és a vér minőségének fenntartásában, így támogathatja a keringést."],"panel":"","y":12404,"x":282,"w":888,"h":238},{"t":"h","n":2,"html":"🌿 Milyen hatásai vannak?","fs":30,"fw":400,"kozep":false,"panel":"","y":12684,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"Vendégek beszámolói szerint a következő pozitív változások voltak tapasztalhatók:","fs":17,"fw":400,"kozep":false,"panel":"","y":12768,"x":273,"w":896,"h":24},{"t":"ul","rendezett":false,"elemek":["Könnyebb emésztés, kevesebb puffadás","Nagyobb energiaszint, kevesebb kimerültség","Jobb ciklus, enyhébb PMS vagy menstruációs görcsök","Erősebb immunitás, ritkább megbetegedések","Általános közérzetjavulás – testi-lelki egyensúly érzése"],"panel":"","y":12816,"x":282,"w":888,"h":119},{"t":"p","n":0,"html":"Fontos: a fenti tapasztalatok egyéni élményeken alapulnak, nem helyettesítik az orvosi kezelést.","fs":17,"fw":400,"kozep":false,"panel":"","y":12959,"x":273,"w":896,"h":24},{"t":"h","n":2,"html":"⏳ Mennyi idő után fejti ki hatását?","fs":30,"fw":400,"kozep":false,"panel":"","y":13025,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"A legtöbb vendég 4–6 héten belül tapasztal javulást, de az eredmény egyéni életmód, szervezeti állapot és energetikai érzékenység függvénye.","fs":17,"fw":400,"kozep":false,"panel":"","y":13090,"x":273,"w":896,"h":48},{"t":"h","n":2,"html":"⚠️ Mik a kockázatai, mellékhatásai?","fs":30,"fw":400,"kozep":false,"panel":"","y":13180,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"Mint minden piercing esetén, a lép piercingnél is előfordulhat:","fs":17,"fw":400,"kozep":false,"panel":"","y":13246,"x":273,"w":896,"h":24},{"t":"ul","rendezett":false,"elemek":["Helyi bőrirritáció vagy enyhe gyulladás","Fertőzés, ha nem steril eszközökkel történik a szúrás","Kisebb fájdalom vagy nyomásérzet a gyógyulás időszaka alatt","Pontatlanság esetén a hatás csökkenhet"],"panel":"","y":13293,"x":282,"w":888,"h":95},{"t":"p","n":0,"html":"Ezért kiemelten fontos, hogy a beavatkozást szakképzett, fülakupunktúrás gyakorlattal rendelkező szakember végezze, steril körülmények között.","fs":17,"fw":400,"kozep":false,"panel":"","y":13412,"x":273,"w":896,"h":48},{"t":"h","n":2,"html":"💎 Mit jelent a garancia?","fs":30,"fw":400,"kozep":false,"panel":"","y":13502,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"A Medical Piercing garanciája azt jelenti, hogy:","fs":17,"fw":400,"kozep":false,"panel":"","y":13568,"x":273,"w":896,"h":24},{"t":"ul","rendezett":false,"elemek":["A szúrás pontmérő műszerrel meghatározott helyre történik","A beavatkozást szakmailag képzett szakember végzi","Ha 6 hét után nem tapasztalsz javulást, mindössze az új ékszer áráért megerősítő piercinget szúrunk egy másik pontba"],"panel":"","y":13615,"x":282,"w":888,"h":95},{"t":"p","n":0,"html":"Minden ékszerünk magas minőségű titánból készül, antiallergén, orvosi tisztaságú anyag. A gyógyulás során ingyenes kontrollt biztosítunk, amíg minden rendben nem alakul.","fs":17,"fw":400,"kozep":false,"panel":"","y":13734,"x":273,"w":896,"h":48},{"t":"p","n":0,"html":"A garancia célja, hogy vendégeink biztonságban érezzék magukat, és biztosak lehessenek benne, hogy a lehető legnagyobb gondossággal kapták meg a szolgáltatást.","fs":17,"fw":400,"kozep":false,"panel":"","y":13782,"x":273,"w":896,"h":48}]},{"t":"kep","src":"/assets/img/f18724_7daed31a68af429c88679cf304ed6283.webp","alt":"lep-pont-helye-a-fulben.jpg","link":"","bg":false,"nw":580,"nh":580,"panel":"","y":12020,"x":569,"w":232,"h":232},{"t":"gomb","szoveg":"Időpontot foglalok!","href":"/idopontfoglalas","kulso":false,"y":13893,"x":645,"w":179,"h":46}]}}],"urlapok":[],"magassag":14675}