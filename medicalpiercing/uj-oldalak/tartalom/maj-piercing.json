7,"h":40},{"t":"p","n":0,"html":"Budapesten","fs":16,"fw":400,"kozep":true,"panel":"","y":12001,"x":646,"w":132,"h":24}],"kartya":true}]}]}},{"id":"comp-mdof5gxo","y":12092,"h":2697,"bgSzin":"rgb(255, 255, 255)","bgKep":"","hatterElhagyva":0,"horgonyok":[],"fa":{"t":"verem","k":[{"t":"h","n":2,"html":"Máj piercing információk","fs":40,"fw":400,"kozep":false,"panel":"","y":12139,"x":267,"w":943,"h":56},{"t":"verem","k":[{"t":"h","n":2,"html":"🧬 Mi az a máj piercing?","fs":30,"fw":400,"kozep":false,"panel":"","y":12229,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"A máj piercing egy olyan közérzetjavító testékszer, amelyet a fül azon részébe szúrnak, ahol a hagyományos kínai orvoslás (TCM) szerint a máj energetikai pontja található. A cél a pont tartós stimulálása, amely vendégeink visszajelzései szerint pozitív hatással vannak a májjal kapcsolatos tünetekre.","fs":17,"fw":400,"kozep":false,"panel":"","y":12313,"x":273,"w":896,"h":71},{"t":"h","n":2,"html":"📍 Hova helyezik a fülbe?","fs":30,"fw":400,"kozep":false,"panel":"","y":12408,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"A piercinget a fülkagyló belső részére (concha területre) szúrják, egy akupunktúrás pontba, amely a májhoz kapcsolódik az aurikuloterápia térképén. A pontos helymeghatározás akupunktúrás pontmérő készülékkel történik.","fs":17,"fw":400,"kozep":false,"panel":"","y":12492,"x":273,"w":896,"h":48},{"t":"h","n":2,"html":"🤕 Milyen panaszok esetén hatásos?","fs":30,"fw":400,"kozep":false,"panel":"","y":12825,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"A máj piercing vendégeink visszajelzései alapján az alábbi panaszokra lehet jó hatással:","fs":17,"fw":400,"kozep":false,"panel":"","y":12909,"x":273,"w":896,"h":24},{"t":"ul","rendezett":true,"elemek":["Májméregtelenítés támogatása – a pont stimulálása serkentheti az anyagcserét, segíthet a szervezet természetes tisztulásában.","Hormonális egyensúly – mivel a máj részt vesz a hormonok lebontásában, a pont stimulálása hozzájárulhat a hormonháztartás stabilizálásához.","Stressz és harag csökkentése – a TCM szerint a máj tárolja a haragot, így ennek a pontnak a stimulálása segíthet az érzelmi feszültségek oldásában.","Emésztés és epefunkció javítása – a máj epét termel, ami nélkülözhetetlen a zsírok emésztéséhez. A piercing közvetett módon támogathatja az emésztőrendszert."],"panel":"","y":12957,"x":282,"w":888,"h":286},{"t":"h","n":2,"html":"🌿 Milyen hatásai vannak?","fs":30,"fw":400,"kozep":false,"panel":"","y":13266,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"Vendégtapasztalatok alapján:","fs":17,"fw":400,"kozep":false,"panel":"","y":13350,"x":273,"w":896,"h":24},{"t":"ul","rendezett":false,"elemek":["Fokozhatja a méregtelenítést (főleg életmódváltás részeként)","Csökkentheti az ingerlékenységet, nyugtató hatású lehet","Segítheti a hormonális tünetek enyhülését (pl. PMS, menopauza)","Támogathatja a zsírbontást, különösen emésztési panaszok esetén","Javíthatja a közérzetet és energiaszintet"],"panel":"","y":13398,"x":282,"w":888,"h":238},{"t":"p","n":0,"html":"Fontos: ezek nem orvosi állítások, hanem egyéni beszámolókon és tapasztalatokon alapulnak.","fs":17,"fw":400,"kozep":false,"panel":"","y":13636,"x":273,"w":896,"h":24},{"t":"h","n":2,"html":"⏳ Mennyi idő után fejti ki hatását?","fs":30,"fw":400,"kozep":false,"panel":"","y":13725,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"A teljes hatás kialakulása jellemzően 4–6 hétig is eltarthat, egyéni fiziológiai és életmódbeli tényezőktől függően.","fs":17,"fw":400,"kozep":false,"panel":"","y":13815,"x":273,"w":896,"h":48},{"t":"h","n":2,"html":"⚠️ Mik a kockázatai, mellékhatásai?","fs":30,"fw":400,"kozep":false,"panel":"","y":13886,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"Mint minden fülpiercing behelyezésénél, itt is előfordulhat:","fs":17,"fw":400,"kozep":false,"panel":"","y":13952,"x":273,"w":896,"h":24},{"t":"ul","rendezett":false,"elemek":["Helyi irritáció vagy gyulladás","Fertőzés, ha nem steril környezetben történik a szúrás","Kisebb fájdalom, nyomásérzet a gyógyulás idején (kb. 4–6 hét)","Nem megfelelő elhelyezés esetén csökkenhet a hatékonyság"],"panel":"","y":14000,"x":282,"w":888,"h":190},{"t":"p","n":0,"html":"<strong>Ezért kiemelten fontos, hogy a máj piercinget fülakupunktúrás szakember végezze, megfelelő és steril eszközökkel és pontmérő műszerrel.</strong>","fs":17,"fw":400,"kozep":false,"panel":"","y":14190,"x":273,"w":896,"h":48},{"t":"h","n":2,"html":"💎 Mit jelent a garancia?","fs":30,"fw":400,"kozep":false,"panel":"","y":14261,"x":273,"w":896,"h":42},{"t":"p","n":0,"html":"A Medical Piercing garanciája a következőt jelenti:","fs":17,"fw":400,"kozep":false,"panel":"","y":14345,"x":273,"w":896,"h":24},{"t":"ul","rendezett":false,"elemek":["Pontos pontmeghatározás és szúrás orvosi vagy akupunktúrás tapasztalattal rendelkező szakember által","Ha 6 hét után sem vált ki a piercing javulást, akkor megerősítő piercinget helyezünk el mindössze az új ékszer áráért"],"panel":"","y":14393,"x":282,"w":888,"h":95},{"t":"ul","rendezett":false,"elemek":["Ékszereink a legmagasabb minőségű titánium piercingek, amelyek antiallergének. Ettől függetlenül a szúrás után ingyenes és korlátlan kontrollt biztosítunk vendégeinknek, hiszen a nyugodt és eredményes gyógyulás közös érdekünk."],"panel":"","y":14512,"x":282,"w":888,"h":95},{"t":"p","n":0,"html":"A garancia célja, hogy vendégeink biztonságban érezzék magukat, és valóban azt kapják, amit a szolgáltatás ígér.","fs":17,"fw":400,"kozep":false,"panel":"","y":14607,"x":273,"w":896,"h":24}]},{"t":"kep","src":"/assets/img/f18724_1059837093ca4ccea25abc401abd4507.webp","alt":"","link":"","bg":false,"nw":580,"nh":580,"panel":"","y":12589,"x":587,"w":216,"h":216},{"t":"gomb","szoveg":"Időpontot foglalok!","href":"/idopontfoglalas","kulso":false,"y":14694,"x":645,"w":179,"h":46}]}}],"urlapok":[],"magassag":15476}